# Zalo Ads production cutover — Prod-S3 / PROD-P0-ZALO
# Usage: set -a && source deploy/env.zalo-prod.example && set +a

export DATABASE_URL=postgresql://ptt:***@127.0.0.1:5432/ptt_agency
export PTT_TOKEN_VAULT_KEY=                          # required — AES token vault

# Production: real Zalo API (no stub, no pilot gate)
export PTT_ZALO_INSIGHTS_SYNC=1
export PTT_ZALO_ADS_STUB=0
export PTT_ZALO_ADS_PILOT=0
# Optional scoped rollout: export PTT_ZALO_ADS_PILOT=1 && export PTT_ZALO_ADS_PILOT_CLIENTS=uuid1,uuid2

export PTT_ZALO_FORM_POLL=1
export PTT_ZALO_FORM_POLL_SLA=1
export PTT_ZALO_FORM_POLL_SLA_MINUTES=15

export PTT_ZALO_ALERTS_ENABLED=1
export PTT_ZALO_TOKEN_REFRESH=1
# export PTT_ZALO_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# OAuth (required prod)
export PTT_ZALO_APP_ID=
export PTT_ZALO_APP_SECRET=
export PTT_ZALO_OAUTH_REDIRECT_URI=https://ops.pttads.vn/api/v1/zalo-ads/oauth/callback

export CRM_ZALO_WEBHOOK_SECRET=
export PTT_WEBHOOKS_NEST_ZALO=1

export PTT_JOBS_ENABLED=1
export PTT_API_URL=http://127.0.0.1:3000
export NEXT_PUBLIC_PTT_API_URL=http://127.0.0.1:3000

# Gate script defaults
export ZALO_STAGING_ENV=$PWD/deploy/env.zalo-prod.example
export STAFF_EMAIL=staff@demo.local
export STAFF_PASSWORD=demo123

# SEO Phase 6 (B6) — BI + Gate D/E enterprise pilot
# Merge vào .env staging/prod (idempotent append via staging_seo_gate_* scripts)

# --- Gate D (BI + CWV + crawl reminders + AEO schedule) ---
PTT_CWV_ENABLED=1
PTT_CWV_STUB=1
PTT_CWV_PER_CLIENT=3
PTT_CWV_MAX_CLIENTS=20

PTT_CRAWL_REMINDER_ENABLED=1
PTT_CRAWL_REMINDER_DAYS=30

PTT_AEO_SCHEDULE_ENABLED=1
PTT_AEO_AUTO_DRAFT_ENABLED=1
PTT_AEO_SCHEDULE_MAX_CLIENTS=10

# ClickHouse BI export (daily timer ptt-seo-clickhouse-export.timer)
PTT_SEO_BI_EXPORT_ENABLED=1
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=ptt
CLICKHOUSE_PASSWORD=change-me

# Cron auth (HTTP mode — Nest /api/v1/seo/cron/gate-d|gate-e)
# PTT_SEO_CRON_SECRET=change-me-gate-de
# PTT_SEO_CRON_BASE_URL=https://staging.pttads.vn

# Optional Teams alerts (song song Slack)
# PTT_SEO_TEAMS_WEBHOOK=https://outlook.office.com/webhook/...

# --- Gate E (crawl connector + rank live + CMS pilot) ---
PTT_CRAWL_CONNECTOR_ENABLED=1
PTT_RANK_LIVE_ENABLED=1
PTT_SERP_PROVIDER=stub

PTT_SEO_ENTERPRISE_ENABLED=1
PTT_SEO_CMS_AUTO_PUBLISH=1
PTT_SEO_CMS_WEBHOOK_SECRET=change-me-cms-pilot
PTT_SEO_CMS_PILOT_WEBHOOK_URL=https://staging.pttads.vn/api/v1/seo/internal/cms-webhook/receive

# Prod cutover (6.5) — bật khi có keys thật
# PTT_CWV_STUB=0
# PAGESPEED_API_KEY=...
# PTT_SERP_PROVIDER=serpapi
# PTT_SERP_API_KEY=...

# ops-web feature flags
NEXT_PUBLIC_PTT_SEO_BI_ENABLED=1
NEXT_PUBLIC_PTT_SEO_CMS_ENABLED=1

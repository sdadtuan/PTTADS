# SEO/AEO Phase 0 + B1 — staff ops-web pilot (Nest PG native, no Flask)
# Apply PG schema: psql "$DATABASE_URL" -f deploy/sql/seo_aeo_pg_schema.sql

SEO_AEO_DB=pg
DATABASE_URL=postgresql://ptt:ptt@127.0.0.1:5432/ptt_crm

# Worker + job queue (GSC/GA4 sync)
PTT_JOBS_ENABLED=1
PTT_GSC_SYNC_ENABLED=1
PTT_GA4_SYNC_ENABLED=1

# GSC OAuth (register redirect in Google Cloud Console)
PTT_GSC_OAUTH_CLIENT_ID=
PTT_GSC_OAUTH_CLIENT_SECRET=
PTT_GSC_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/seo/gsc/oauth/callback

# GA4 OAuth (optional separate redirect; defaults from GSC URI)
PTT_GA4_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/v1/seo/ga4/oauth/callback

# Token vault (recommended prod — compatible with Python ptt_meta/token_crypto)
PTT_TOKEN_VAULT_KEY=

# ops-web URL for OAuth callback redirect
PTT_OPS_WEB_URL=http://127.0.0.1:3001

# Seed pilot: python3 scripts/seed_seo_pilot_client_settings.py --apply [--portal-map]

# Comma-separated customer_id integers for pilot hub filter (optional)
PTT_SEO_AEO_PILOT_CUSTOMERS=

# ops-web feature flags (rebuild ops-web after change)
# NEXT_PUBLIC_PTT_SEO_HUB_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_CLIENT_WORKSPACE_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_RESEARCH_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_CONTENT_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_TECHNICAL_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_REPORTS_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_GOVERNANCE_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_STRATEGY_ENABLED=1

# Governance + alerts (Phase 3)
# PTT_SEO_GOVERNANCE_ENABLED=1
# PTT_SEO_SLACK_WEBHOOK=
# PTT_SEO_TEAMS_WEBHOOK=
# PTT_CWV_STUB=1
# PAGESPEED_API_KEY=

# Nest staff API (default on when module loaded):
# GET  /api/v1/seo/hub
# GET  /api/v1/seo/clients
# GET  /api/v1/seo/clients/:id
# GET  /api/v1/seo/clients/:id/tasks
# GET  /api/v1/seo/clients/:id/settings
# PUT  /api/v1/seo/clients/:id/settings
# POST /api/v1/seo/clients/:id/sync/:source   (gsc | ga4)
# GET  /api/v1/seo/clients/:id/gsc/oauth/url?site_url=
# GET  /api/v1/seo/clients/:id/ga4/oauth/url?property_id=
# GET  /api/v1/seo/gsc/oauth/callback  (public — Google redirect)
# GET  /api/v1/seo/ga4/oauth/callback
# --- Phase 2 (B2) Research + Content ---
# GET  /api/v1/seo/clients/:id/research
# GET/POST /api/v1/seo/clients/:id/keywords · POST .../keywords/import
# GET/POST /api/v1/seo/clients/:id/questions
# GET/POST /api/v1/seo/clients/:id/clusters
# POST /api/v1/seo/research/brief-preview · POST /api/v1/seo/research/to-content
# GET  /api/v1/seo/content/pipeline
# GET/PATCH /api/v1/seo/content/:id · PATCH .../status · POST .../approve
# GET/POST /api/v1/seo/content/:id/versions · GET .../aeo-checklist
# --- Phase 3 (B3) Technical + Reports + Governance + Strategy ---
# GET/POST /api/v1/seo/clients/:id/issues · POST .../issues/import · PATCH /issues/:id
# GET /api/v1/seo/clients/:id/cwv · POST .../cwv/capture
# GET /api/v1/seo/clients/:id/dashboard/:type · GET .../reports/export · GET/POST .../reports/schedules
# GET /api/v1/seo/alerts · POST /alerts/:id/resolve · POST /alerts/run-checks
# GET /api/v1/seo/governance/policies · GET /governance/compliance · POST /content/:id/governance/evaluate
# GET /api/v1/seo/clients/:id/strategy/okr · POST .../strategy/goals · POST .../kpis/refresh
# --- Phase 4 (B4) AEO + Authority + Ranks + Automations + Freshness + Experiments ---
# GET/POST /api/v1/seo/clients/:id/aeo/queries · GET .../aeo/coverage · POST .../aeo/scan
# GET /api/v1/seo/clients/:id/authority/signals · POST .../authority/import
# GET /api/v1/seo/clients/:id/ranks/keywords · POST .../ranks/capture · GET .../ranks/sov
# GET /api/v1/seo/automations/status · POST /automations/run-alert-checks
# GET /api/v1/seo/clients/:id/freshness/queue · POST .../freshness/rescore
# GET /api/v1/seo/clients/:id/experiments · PTT_SEO_EXPERIMENTS_ENABLED=1
# PTT_AEO_SCAN_STUB=1 · PTT_SERP_PROVIDER=stub

# ops-web routes: /seo/hub · /seo/clients · /seo/clients/[id]
#                 /seo/research · /seo/content · /seo/content/[id]
#                 /seo/technical · /seo/reports · /seo/governance · /seo/strategy
#                 /seo/aeo · /seo/authority · /seo/ranks · /seo/automations · /seo/freshness · /seo/experiments
# NEXT_PUBLIC_PTT_SEO_AEO_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_AUTHORITY_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_RANKS_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_AUTOMATIONS_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_FRESHNESS_ENABLED=1
# NEXT_PUBLIC_PTT_SEO_EXPERIMENTS_ENABLED=0

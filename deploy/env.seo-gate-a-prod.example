# SEO Phase 7 (B7) — Gate A go-live prod pilot
# Merge vào /var/www/ptt/.env sau staged cutover (Governance → Portal → Experiments)

export SEO_AEO_DB=pg
export DATABASE_URL=postgresql://ptt:***@127.0.0.1:5432/ptt_agency

# --- Staged prod flags (7.2) — enable ONE step at a time via close_phase5_prod_cutover.sh ---
export PTT_SEO_GOVERNANCE_ENABLED=1
export PTT_PORTAL_SEO_ENABLED=0
export PTT_SEO_EXPERIMENTS_ENABLED=0

# Portal bridge (step 2)
export PTT_PORTAL_SEO_SERVICE_TOKEN=
export PTT_FLASK_MONOLITH_URL=http://127.0.0.1:8002

# Enterprise / BI (from B6 — optional at Gate A)
export PTT_SEO_ENTERPRISE_ENABLED=1
export PTT_SEO_BI_EXPORT_ENABLED=1
export PTT_CWV_STUB=1
export PTT_SERP_PROVIDER=stub

# ops-web staff console (rs.pttads.vn)
export PTT_OPS_CORS_ORIGINS=https://rs.pttads.vn,https://ops.pttads.vn,http://127.0.0.1:3200
NEXT_PUBLIC_PTT_SEO_HUB_ENABLED=1
NEXT_PUBLIC_PTT_SEO_GOVERNANCE_ENABLED=1
NEXT_PUBLIC_PTT_SEO_EXPERIMENTS_ENABLED=0
NEXT_PUBLIC_PTT_SEO_GATE_A_ENABLED=1

# Cron (Nest /api/v1/seo/cron/*)
# PTT_SEO_CRON_SECRET=change-me-gate-a

# --- Gate A automated checks (7.1) ---
# ./scripts/seo_gate_a_cutover_gate.sh
# ./scripts/phase5_soak_record.sh   # daily ≥7 days (7.3)
# PHASE5_SKIP_SOAK=0 ./scripts/seo_gate_a_cutover_gate.sh

# Staged cutover (7.2):
# APPLY=1 PHASE5_ENABLE_GOVERNANCE=1 sudo -E ./scripts/close_phase5_prod_cutover.sh
# APPLY=1 PHASE5_ENABLE_PORTAL=1 PHASE5_SKIP_PORTAL_SIGNOFF=0 sudo -E ./scripts/close_phase5_prod_cutover.sh
# APPLY=1 PHASE5_ENABLE_EXPERIMENTS=1 sudo -E ./scripts/close_phase5_prod_cutover.sh

# Nginx /crm/seo → /seo (7.7):
# include deploy/nginx-seo-gate-a-redirect.conf in rs.pttads.vn server block
# sudo nginx -t && sudo systemctl reload nginx

# Human sign-off (7.5): copy docs/evidence/seo-gate-a-signoff.template.json → fill signoffs
